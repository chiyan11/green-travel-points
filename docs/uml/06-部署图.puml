@startuml 图2-3 系统物理架构 部署图
' 依据：docs/设计规格说明书.md §2.1.3；deploy/docker-compose.yml（2026-11-24 实际内容）
' 事实：compose 只有 mysql + api；web 用 Vite dev server 单独启动；nginx 未编入；Worker 未实现

skinparam defaultFontName "Microsoft YaHei"
skinparam dpi 150
skinparam shadowing false
skinparam node {
  BackgroundColor #F5F9FF
  BorderColor #2E5C8A
}
skinparam databaseBackgroundColor #FFF6E5
skinparam artifactBackgroundColor #FFFFFF

title 物理架构：本地 Vite + API + MySQL（compose 仅 mysql + api）

node "客户端" as client {
  artifact "浏览器\nChrome / Edge" as browser
}

node "开发机 / 演示机（Windows 11 或 Linux）" as host {

  node "Vite dev server\nnpm run dev，:5173" as vite {
    artifact "apps/web 源码\nReact 19 + TypeScript 7" as webapp
  }

  node "api 进程 / 容器\n:8080" as apinode {
    artifact "Go 二进制\ncmd/server" as apisvc
    artifact "Outbox 写入\n（业务事务内）" as outboxwrite
  }

  database "mysql 容器\nMySQL 8.0，数据卷 mysql-data" as mysql

  node "docker compose\n仅 mysql + api" as compose
}

cloud "GitHub Actions" as ci {
  artifact "gofmt / vet / test -race / build\n+ tsc / vitest / vite build" as pipeline
}

cloud "模拟数据源" as sim {
  artifact "行程生成脚本\n（HTTP 调用）" as gen
}

' ---------- 通信 ----------
browser --> vite : HTTP :5173
browser --> apisvc : /api/*（Vite 代理到 127.0.0.1:8080）
vite --> apisvc : proxy /api
apisvc --> mysql : database/sql + go-sql-driver/mysql\nTCP 3306
outboxwrite --> mysql : INSERT event_outbox
sim --> apisvc : POST /api/v1/trips
ci ..> host : 构建 / 测试（不自动部署）

note right of outboxwrite
  **只写不消费**
  事件由业务事务写入 event_outbox；
  Worker（轮询、退避、死信）尚未实现，
  因此没有“消费端”节点可画。
end note

note bottom of mysql
  数据卷：mysql-data
  账号：greentravel（仅本库）
  迁移：db/migrations 5 组，启动前执行
end note

note bottom of compose
  **实际 compose 内容**
  services: mysql + api；
  web/nginx 的 Dockerfile 与 nginx.conf 已存在，
  但**未编入** compose，Docker 编排也未实跑。
  前端当前用 `npm run dev` 单独启动。
end note

legend right
  当前可复现路径：
  ① docker compose up -d  → mysql + api
  ② cd apps/web && npm run dev → :5173
  ③ 浏览器访问 http://localhost:5173
  NFR-10 的“一条命令拉起 web”尚未满足，已在设计说明书 §4 记为偏差。
endlegend

@enduml
