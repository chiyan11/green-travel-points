# 复制为 .env 后按需修改（.env 不入库）
# 后端只读环境变量；本地开发可用 PowerShell:
#   Get-Content apps/api/.env.example | ForEach-Object { ... }  # 或直接用 scripts/dev-env.ps1

APP_ENV=dev
APP_NAME=green-travel-points-api
HTTP_ADDR=:8080
HTTP_REQUEST_TIMEOUT=15s
HTTP_SHUTDOWN_TIMEOUT=10s

# 与 deploy/docker-compose.yml 的 MySQL 服务一致
DB_DSN=greentravel:greentravel@tcp(127.0.0.1:3306)/green_travel_points?parseTime=true&loc=Local&charset=utf8mb4
DB_MAX_OPEN_CONNS=20
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=30m
