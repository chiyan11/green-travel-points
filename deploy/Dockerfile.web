# 前端镜像：Node 构建静态产物 → nginx 托管，并把 /api 反代到后端容器。
#
# 依赖只来自 npm ci（Linux 产物）；源码按清单逐个 COPY，不用 `COPY apps/web/ ./`，
# 避免把宿主的 node_modules / dist 覆盖进镜像（历史问题：.bin/vite 失去执行位 → EACCES）。
# 新增构建期必需的文件（如 tsconfig 引用的配置）时，记得在这里补一行。
FROM node:24-alpine AS build

WORKDIR /src
COPY apps/web/package.json apps/web/package-lock.json apps/web/.npmrc ./
RUN npm ci

COPY apps/web/tsconfig.json apps/web/vite.config.ts apps/web/vitest.config.ts apps/web/playwright.config.ts apps/web/index.html ./
COPY apps/web/src ./src
COPY apps/web/e2e ./e2e
RUN npm run build

FROM nginx:1.29-alpine

COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /src/dist /usr/share/nginx/html

EXPOSE 80

# 容器自检：根路径能取到 index.html 即视为可用（与 compose 的 healthcheck 一致）。
HEALTHCHECK --interval=10s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://127.0.0.1/ >/dev/null || exit 1
